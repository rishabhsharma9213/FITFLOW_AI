# FitFlow AI - Environment Configuration Example
#
# LOCAL DEVELOPMENT ONLY (do NOT set VITE_API_URL to localhost in Vercel):
# VITE_API_URL=http://localhost:5000/api
#
# VERCEL PRODUCTION ENVIRONMENT VARIABLES (configure in Vercel Dashboard -> Settings -> Environment Variables):
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/fitflow_ai
# GEMINI_API_KEY=<your-gemini-api-key>
